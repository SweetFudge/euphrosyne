# --- Obligatoire ---
# Numéro du contact à qui répondre (format international, chiffres uniquement)
TARGET_NUMBER=33612345678

# --- Ton identité ---
# Noms qui comptent comme "un tag" s'ils sont écrits dans le texte (séparés par des virgules)
MY_NAMES=Adriano
# Ton numéro : sert à générer un code de jumelage (plus simple que le QR code sur Railway)
PAIRING_PHONE_NUMBER=33600000000

# --- Groupes (laisser vide = tous les groupes) ---
# Noms (ou morceaux de noms) séparés par des virgules
GROUP_NAMES=
# ou identifiants complets 123456789-123456@g.us
GROUP_IDS=

# --- Comportement ---
REPLY_COOLDOWN_SECONDS=30
REPLY_DELAY_MIN_MS=2000
REPLY_DELAY_MAX_MS=6000
QUOTE_MESSAGE=true
# Chemin vers un JSON (tableau de strings) pour remplacer les réponses par défaut
REPLIES_FILE=
# Affiche l'identifiant de chaque expéditeur dans les logs (pour debug)
LOG_SENDERS=false

# --- Stockage de la session (monte un Volume Railway sur /data) ---
AUTH_DIR=./auth

# --- Sujets générés par Claude (optionnel) ---
# Sans clé, le bot utilise les réponses aléatoires de src/replies.json
ANTHROPIC_API_KEY=
# Critères libres décrivant le type de sujet voulu
TOPIC_CRITERIA=sujets drôles et légers autour du sport, de la bouffe et des voyages, jamais de politique
# Modèle (défaut claude-opus-5-5 ; claude-sonnet-5-5 ou claude-haiku-5-5 pour réduire le coût)
CLAUDE_MODEL=claude-opus-5-5
# true = envoie aussi le texte du message qui te tag à Claude (sujet plus pertinent, mais
# le contenu du message quitte WhatsApp vers l'API Anthropic)
TOPIC_USE_MESSAGE_CONTEXT=false
